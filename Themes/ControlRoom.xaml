<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Token Control Room — palet "Futuristic AI Control Center"
         (v5.2, dari color styles Figma yang disetujui user; menggantikan
         Pasangan 4). Nama kunci lama dipertahankan agar halaman tidak
         berubah: CrSage kini = aksen violet, CrGold = amber peringatan.
         CrFaint & CrStopFill adalah turunan redup dari palet yang sama. -->
    <Color x:Key="CrBgColor">#0B0E13</Color>
    <Color x:Key="CrSidebarColor">#0B0E13</Color>
    <Color x:Key="CrPanelColor">#121821</Color>
    <Color x:Key="CrCardColor">#121821</Color>
    <Color x:Key="CrElevatedColor">#1A2330</Color>
    <Color x:Key="CrBorderColor">#1E2A3D</Color>
    <Color x:Key="CrTextColor">#F0F5FA</Color>
    <Color x:Key="CrMutedColor">#8998A9</Color>
    <Color x:Key="CrFaintColor">#5B6B7E</Color>
    <Color x:Key="CrAccentColor">#36D9F5</Color>
    <Color x:Key="CrSageColor">#9274FF</Color>
    <Color x:Key="CrGoldColor">#F5B94C</Color>
    <Color x:Key="CrGreenColor">#38D996</Color>
    <Color x:Key="CrRedColor">#F06475</Color>
    <Color x:Key="CrStopFillColor">#6E2A35</Color>

    <SolidColorBrush x:Key="CrBg" Color="{StaticResource CrBgColor}"/>
    <SolidColorBrush x:Key="CrSidebar" Color="{StaticResource CrSidebarColor}"/>
    <SolidColorBrush x:Key="CrPanel" Color="{StaticResource CrPanelColor}"/>
    <SolidColorBrush x:Key="CrCard" Color="{StaticResource CrCardColor}"/>
    <SolidColorBrush x:Key="CrElevated" Color="{StaticResource CrElevatedColor}"/>
    <SolidColorBrush x:Key="CrBorder" Color="{StaticResource CrBorderColor}"/>
    <SolidColorBrush x:Key="CrText" Color="{StaticResource CrTextColor}"/>
    <SolidColorBrush x:Key="CrMuted" Color="{StaticResource CrMutedColor}"/>
    <SolidColorBrush x:Key="CrFaint" Color="{StaticResource CrFaintColor}"/>
    <SolidColorBrush x:Key="CrAccent" Color="{StaticResource CrAccentColor}"/>
    <SolidColorBrush x:Key="CrSage" Color="{StaticResource CrSageColor}"/>
    <SolidColorBrush x:Key="CrGold" Color="{StaticResource CrGoldColor}"/>
    <SolidColorBrush x:Key="CrGreen" Color="{StaticResource CrGreenColor}"/>
    <SolidColorBrush x:Key="CrRed" Color="{StaticResource CrRedColor}"/>
    <SolidColorBrush x:Key="CrStopFill" Color="{StaticResource CrStopFillColor}"/>

    <!-- Tipografi -->
    <Style x:Key="CrTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
    </Style>
    <Style x:Key="CrCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CrMuted}"/>
    </Style>
    <Style x:Key="CrBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
    </Style>
    <Style x:Key="CrMutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource CrMuted}"/>
    </Style>
    <Style x:Key="CrBigValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
    </Style>

    <!-- Kartu -->
    <Style x:Key="CrCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CrCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Tombol dasar -->
    <Style x:Key="CrButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CrElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource CrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tombol aksi utama: isian cyan, teks gelap (v5.2, dari
         spesimen Button Primary di Design System Figma). -->
    <Style x:Key="CrPrimaryButton" TargetType="Button" BasedOn="{StaticResource CrButton}">
        <Setter Property="Background" Value="{StaticResource CrAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrAccent}"/>
        <Setter Property="Foreground" Value="#0B0E13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Tombol Emergency Stop -->
    <Style x:Key="CrStopButton" TargetType="Button" BasedOn="{StaticResource CrButton}">
        <Setter Property="Background" Value="{StaticResource CrStopFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrRed}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Baris navigasi sidebar -->
    <Style x:Key="CrNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CrMuted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="1.5"
                                    Background="{StaticResource CrAccent}" Margin="0,2,10,2" Opacity="0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CrPanel}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CrElevated}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource CrText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kotak teks -->
    <Style x:Key="CrTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CrPanel}"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource CrText}"/>
    </Style>

    <!-- Kotak centang gelap (v5.1) -->
    <!-- Saklar gaya Figma (v5.3.0): rel 40x20 membulat; AKTIF =
         rel cyan + kenop putih di kanan; MATI = rel elevated +
         kenop redup di kiri. Dipakai Settings model Figma. -->
    <Style x:Key="CrToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20" Background="Transparent">
                        <Border x:Name="Track" Background="{StaticResource CrElevated}"
                                BorderBrush="{StaticResource CrBorder}" BorderThickness="1"
                                CornerRadius="10"/>
                        <Ellipse x:Name="Knob" Width="14" Height="14"
                                 Fill="{StaticResource CrMuted}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource CrAccent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource CrAccent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource CrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tombol garis bahaya (v5.3.0): Hentikan / Stop / Tutup ala
         Figma — latar warna dasar, garis + teks merah. -->
    <Style x:Key="CrDangerOutline" TargetType="Button" BasedOn="{StaticResource CrButton}">
        <Setter Property="Background" Value="{StaticResource CrBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrRed}"/>
        <Setter Property="Foreground" Value="{StaticResource CrRed}"/>
    </Style>

    <!-- Chip filter (v5.3.0, Activity Center ala Figma): pil
         elevated; varian aktif berisian cyan. -->
    <Style x:Key="CrChip" TargetType="Button" BasedOn="{StaticResource CrButton}">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Background" Value="{StaticResource CrElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource CrMuted}"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style x:Key="CrChipActive" TargetType="Button" BasedOn="{StaticResource CrChip}">
        <Setter Property="Background" Value="{StaticResource CrAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrAccent}"/>
        <Setter Property="Foreground" Value="#0B0E13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CrCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource CrBg}" BorderBrush="{StaticResource CrBorder}"
                                BorderThickness="1" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Path x:Name="Check" Data="M 3.5 9.5 L 7.5 13 L 14 5.5"
                                  Stroke="#0B0E13" StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource CrAccent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown gelap (v5.1) -->
    <Style x:Key="CrComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CrElevated}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CrElevated}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CrComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource CrComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{StaticResource CrPanel}" BorderBrush="{StaticResource CrBorder}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource CrMuted}" StrokeThickness="1.6"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,30,0" VerticalAlignment="Center"/>
                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource CrPanel}" BorderBrush="{StaticResource CrBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Daftar -->
    <Style x:Key="CrListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource CrPanel}"/>
        <Setter Property="Foreground" Value="{StaticResource CrText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

</ResourceDictionary>
