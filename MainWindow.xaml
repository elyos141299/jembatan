<Window x:Class="Jembatan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseLink — Control Room"
        Width="1200" Height="780" MinWidth="1000" MinHeight="660"
        Background="{StaticResource CrBg}"
        Foreground="{StaticResource CrText}"
        FontFamily="/Jembatan;component/Fonts/#Inter, Segoe UI"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR (v5.7.0: 5 halaman Tray-First) ============ -->
        <Border Grid.Column="0" Background="{StaticResource CrSidebar}"
                BorderBrush="{StaticResource CrBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kepala: logo + nama -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,16,6">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource CrCard}"
                            BorderBrush="{StaticResource CrBorder}" BorderThickness="1">
                        <!-- Logo Simpul Tautan: dua rangka anyaman + titik emas -->
                        <Grid>
                            <Border Width="20" Height="20" CornerRadius="5"
                                    BorderBrush="{StaticResource CrAccent}" BorderThickness="2.5"/>
                            <Border Width="20" Height="20" CornerRadius="5"
                                    BorderBrush="{StaticResource CrSage}" BorderThickness="2.5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource CrGold}"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MuseLink" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="DESKTOP BRIDGE" FontSize="8.5" Foreground="{StaticResource CrFaint}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="MENU" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource CrFaint}" Margin="20,14,0,4"/>

                <!-- Navigasi 5 halaman -->
                <StackPanel x:Name="NavPanel" Grid.Row="2" Margin="10,2,10,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="home" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Home"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="activity" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="∿" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Activity"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="ai" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❯" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="AI"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="about" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Kaki: kartu status dua baris -->
                <Border Grid.Row="3" Style="{StaticResource CrCardStyle}" Padding="14,12" Margin="16,10,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BridgeDot" Width="9" Height="9" Fill="{StaticResource CrGreen}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideBridgeText" Text="Bridge Connected" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Tailscale • 100.126.240.47" Style="{StaticResource CrMutedText}" FontSize="10.5" Margin="17,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse x:Name="ClaudeDot" Width="9" Height="9" Fill="{StaticResource CrSage}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideClaudeText" Text="Muse Online" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            <TextBlock x:Name="VersionText" Text="v5.7" Style="{StaticResource CrMutedText}" FontSize="10.5" Margin="8,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ AREA UTAMA ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bar atas ramping: judul + breadcrumb kiri;
                 dua lencana status + tombol jendela kanan -->
            <Border Grid.Row="0" BorderBrush="{StaticResource CrBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="24,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource CrTitle}"/>
                        <TextBlock x:Name="CrumbText" Text="MuseLink / Home" Style="{StaticResource CrMutedText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource CrSageColor}" Opacity="0.14"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource CrSage}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MuseBadgeText" Text="Muse Connected" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CrSage}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource CrGreenColor}" Opacity="0.14"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BridgeBadgeDot" Width="7" Height="7" Fill="{StaticResource CrGreen}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BridgeBadgeText" Text="Bridge Online" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CrGreen}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="─" Style="{StaticResource CrButton}" Padding="10,4" Margin="16,0,0,0" Click="MinButton_Click"/>
                        <Button Content="▢" Style="{StaticResource CrButton}" Padding="10,4" Margin="6,0,0,0" Click="MaxButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CrButton}" Padding="10,4" Margin="6,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Spanduk halt -->
            <Border x:Name="HaltBanner" Grid.Row="1" Background="{StaticResource CrStopFill}" Visibility="Collapsed">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EMERGENCY STOP AKTIF — semua input dari bridge sedang ditahan."
                               Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Lepas Stop" Style="{StaticResource CrButton}" Click="ReleaseStop_Click"/>
                </Grid>
            </Border>

            <!-- Host halaman -->
            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="24"/>
        </Grid>
    </Grid>
</Window>
