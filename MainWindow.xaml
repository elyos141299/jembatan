<Window x:Class="Jembatan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseLink — Control Room"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource CrBg}"
        Foreground="{StaticResource CrText}"
        FontFamily="/Jembatan;component/Fonts/#Inter, Segoe UI"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR (persis Figma v5.3) ============ -->
        <Border Grid.Column="0" Background="{StaticResource CrSidebar}"
                BorderBrush="{StaticResource CrBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kepala: logo + nama -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,16,6">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource CrCard}"
                            BorderBrush="{StaticResource CrBorder}" BorderThickness="1">
                        <!-- Logo Simpul Tautan: dua rangka anyaman + titik emas -->
                        <Grid>
                            <Border Width="20" Height="20" CornerRadius="5"
                                    BorderBrush="{StaticResource CrAccent}" BorderThickness="2.5"/>
                            <Border Width="20" Height="20" CornerRadius="5"
                                    BorderBrush="{StaticResource CrSage}" BorderThickness="2.5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource CrGold}"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MuseLink" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="AI CONTROL CENTER" FontSize="8.5" Foreground="{StaticResource CrFaint}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="MENU" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource CrFaint}" Margin="20,14,0,4"/>

                <!-- Navigasi 9 halaman (urutan &amp; nama persis Figma) -->
                <StackPanel x:Name="NavPanel" Grid.Row="2" Margin="10,2,10,0">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="overview" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Overview"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="console" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❯" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Muse Console"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="desktop" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▭" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Desktop Control"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="live" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Live Screen"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="activity" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="∿" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Activity Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="automation" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Automation Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="monitor" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▲" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="System Monitor"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="integrations" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◎" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Integrations"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource CrNavButton}" GroupName="MainNav" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="24" FontSize="14" Foreground="{StaticResource CrFaint}"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Kaki: kartu status dua baris (persis Figma) -->
                <Border Grid.Row="3" Style="{StaticResource CrCardStyle}" Padding="14,12" Margin="16,10,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BridgeDot" Width="9" Height="9" Fill="{StaticResource CrGreen}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideBridgeText" Text="Bridge Connected" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Tailscale • 100.126.240.47" Style="{StaticResource CrMutedText}" FontSize="10.5" Margin="17,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse x:Name="ClaudeDot" Width="9" Height="9" Fill="{StaticResource CrSage}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SideClaudeText" Text="Muse Online" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            <TextBlock x:Name="VersionText" Text="v5.3" Style="{StaticResource CrMutedText}" FontSize="10.5" Margin="8,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ AREA UTAMA ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bar atas (persis Figma): judul + breadcrumb kiri;
                 badge status, lonceng, chip pengguna kanan -->
            <Border Grid.Row="0" BorderBrush="{StaticResource CrBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="24,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Overview" Style="{StaticResource CrTitle}"/>
                        <TextBlock x:Name="CrumbText" Text="MuseLink / Overview" Style="{StaticResource CrMutedText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource CrSageColor}" Opacity="0.14"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource CrSage}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MuseBadgeText" Text="Muse Connected" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CrSage}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource CrGreenColor}" Opacity="0.14"/>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BridgeBadgeDot" Width="7" Height="7" Fill="{StaticResource CrGreen}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BridgeBadgeText" Text="Bridge Online" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CrGreen}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🔔" FontSize="13"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource CrRed}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                        </Grid>
                        <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="30" Height="30" Fill="{StaticResource CrElevated}"/>
                            <TextBlock Text="Y" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CrAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Elyos" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Administrator" FontSize="10" Style="{StaticResource CrMutedText}"/>
                        </StackPanel>
                        <Button Content="─" Style="{StaticResource CrButton}" Padding="10,4" Margin="16,0,0,0" Click="MinButton_Click"/>
                        <Button Content="▢" Style="{StaticResource CrButton}" Padding="10,4" Margin="6,0,0,0" Click="MaxButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CrButton}" Padding="10,4" Margin="6,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Spanduk halt -->
            <Border x:Name="HaltBanner" Grid.Row="1" Background="{StaticResource CrStopFill}" Visibility="Collapsed">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EMERGENCY STOP AKTIF — semua input dari bridge sedang ditahan."
                               Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Lepas Stop" Style="{StaticResource CrButton}" Click="ReleaseStop_Click"/>
                </Grid>
            </Border>

            <!-- Host halaman -->
            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="24"/>
        </Grid>

        <!-- ============ PANEL KONTEKS KANAN (persis Figma) ============ -->
        <Border Grid.Column="2" Background="{StaticResource CrPanel}"
                BorderBrush="{StaticResource CrBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="MUSE — CURRENT ACTIVITY" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CrFaint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse x:Name="RpActDot" Width="8" Height="8" Fill="{StaticResource CrAccent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RpActTitle" Text="Menunggu perintah" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="RpActSub" Text="Bridge • port 8765" Style="{StaticResource CrMutedText}" FontSize="11" Margin="0,4,0,0"/>
                    <Grid x:Name="RpActTrack" Height="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource CrElevated}" CornerRadius="3"/>
                        <Border x:Name="RpActFill" Background="{StaticResource CrAccent}" CornerRadius="3"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource CrBorder}" Margin="0,16,0,0"/>
                    <TextBlock Text="ACTIVE APPLICATION" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CrFaint}" Margin="0,16,0,0"/>
                    <TextBlock x:Name="RpAppTitle" Text="—" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RpAppSub" Text="" Style="{StaticResource CrMutedText}" FontSize="11" Margin="0,3,0,0"/>

                    <Border Height="1" Background="{StaticResource CrBorder}" Margin="0,16,0,0"/>
                    <TextBlock Text="CURRENT TASK" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CrFaint}" Margin="0,16,0,0"/>
                    <Border Background="{StaticResource CrElevated}" BorderBrush="{StaticResource CrBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="RpTaskTitle" Text="Tidak ada tugas berjalan" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RpTaskSub" Text="Bridge siaga" Style="{StaticResource CrMutedText}" FontSize="10.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource CrBorder}" Margin="0,16,0,0"/>
                    <TextBlock Text="RECENT EVENTS" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CrFaint}" Margin="0,16,0,0"/>
                    <StackPanel x:Name="RpEvents" Margin="0,6,0,0"/>

                    <Border Height="1" Background="{StaticResource CrBorder}" Margin="0,16,0,0"/>
                    <TextBlock Text="SYSTEM INFORMATION" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource CrFaint}" Margin="0,16,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Style="{StaticResource CrMutedText}"/>
                        <TextBlock x:Name="RpCpuVal" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="RpCpuTrack" Height="5" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource CrElevated}" CornerRadius="2.5"/>
                        <Border x:Name="RpCpuFill" Background="{StaticResource CrAccent}" CornerRadius="2.5"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Style="{StaticResource CrMutedText}"/>
                        <TextBlock x:Name="RpRamVal" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="RpRamTrack" Height="5" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource CrElevated}" CornerRadius="2.5"/>
                        <Border x:Name="RpRamFill" Background="{StaticResource CrSage}" CornerRadius="2.5"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="GPU" FontSize="11" FontWeight="SemiBold" Style="{StaticResource CrMutedText}"/>
                        <TextBlock x:Name="RpGpuVal" Text="—" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="RpGpuTrack" Height="5" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{StaticResource CrElevated}" CornerRadius="2.5"/>
                        <Border x:Name="RpGpuFill" Background="{StaticResource CrGreen}" CornerRadius="2.5"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
