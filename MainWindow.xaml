<Window x:Class="Jembatan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseLink"
        Width="660" Height="560"
        MinWidth="520" MinHeight="440"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Tombol besar ala Jembatan v1: warna diatur gaya
             Merah/Hijau, hover cukup diredupkan. -->
        <ControlTemplate x:Key="BigBtnTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="BtnRed" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource BigBtnTemplate}"/>
            <Setter Property="Background" Value="#B9372D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource BigBtnTemplate}"/>
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="MuseLink"
                   FontSize="21" FontWeight="SemiBold"
                   Foreground="#F0F6FC"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Rectangle x:Name="StatusBox" Width="11" Height="11"
                       Fill="#2EA043" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#F0F6FC"
                       Text="Muse terhubung"/>
        </StackPanel>

        <TextBlock x:Name="PortText" Grid.Row="2" Margin="0,6,0,0"
                   FontSize="12" Foreground="#8B949E"
                   Text="Port 8765 • Hanya bisa dijangkau lewat jaringan Tailscale kamu — tidak terbuka ke internet."/>

        <Border Grid.Row="3" Margin="0,14,0,0"
                Background="#161B22" CornerRadius="4"
                BorderBrush="#21262D" BorderThickness="1">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#C9D1D9"
                     FontFamily="Consolas" FontSize="12.5"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10,8"/>
        </Border>

        <Button x:Name="ToggleBtn" Grid.Row="4" Margin="0,14,0,0"
                Height="48" Content="PUTUSKAN"
                Style="{StaticResource BtnRed}"
                Click="ToggleBtn_Click"/>
    </Grid>
</Window>
