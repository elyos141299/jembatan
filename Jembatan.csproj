<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Jembatan</AssemblyName>
    <RootNamespace>Jembatan</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.1</Version>
    <FileVersion>2.3.1.0</FileVersion>
    <!-- WebView2 (panel chat v2.2): loader native-nya harus ikut
         ter-extract dari berkas tunggal hasil publish, kalau tidak
         panel chat gagal jalan dari Jembatan.exe single-file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
