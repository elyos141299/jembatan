<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Jembatan</AssemblyName>
    <StartupObject>Jembatan.Program</StartupObject>
    <RootNamespace>Jembatan</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>5.18.0</Version>
    <AssemblyVersion>5.18.0.0</AssemblyVersion>
    <FileVersion>5.18.0.0</FileVersion>
    <!-- Loader native (SQLite dsb.) harus ikut ter-extract dari
         berkas tunggal hasil publish. Paket WebView2 DICABUT di
         v5.8.0 (perintah user: tampilan v1 tanpa WebView2) —
         kode sudah tidak memakainya sejak shell WPF v5.0. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Sidecar AI visual (v5.4.0): skrip Python pendamping
       (YOLO + EasyOCR di GPU) ikut terbit di samping exe;
       AiBridge menyalinnya ke AI-Tools\sidecar\ saat dipakai. -->
  <ItemGroup>
    <None Include="ai_sidecar.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="pw_sidecar.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Font Inter tertanam (v5.2, lisensi OFL — Fonts/LICENSE.txt):
       dirujuk MainWindow sebagai keluarga "/Jembatan;component/
       Fonts/#Inter". Remove dulu agar tidak dobel dengan glob
       bawaan SDK, lalu Include tepat satu kali sebagai Resource. -->
  <ItemGroup>
    <Resource Remove="Fonts\*.ttf" />
    <None Remove="Fonts\*.ttf" />
    <Content Remove="Fonts\*.ttf" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Audio (v2.5.0): NAudio untuk loopback WASAPI (/listen) dan
       System.Speech untuk TTS bawaan Windows (/say). -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- OCR (v2.4.4): TargetFramework diarahkan ke permukaan SDK
       Windows 10 19041 agar API WinRT Windows.Media.Ocr (mesin OCR
       bawaan Windows) bisa dipakai. WinForms/WebView2/FlaUI tidak
       terpengaruh oleh arahan ini. -->

  <!-- UI Automation (peta elemen jendela, v2.4.0): lewat FlaUI —
       rujukan rakitan kerangka UIAutomationClient tidak
       terselesaikan di CI (build #13), FlaUI.UIA3 adalah bungkus
       NuGet resmi-komunitas untuk COM UI Automation yang sama. -->
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- v3.0.1: suhu CPU (sensor ring-0) untuk baris rincian panel. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Scheduler Engine (v5.6.0): penyimpanan jadwal di SQLite
       lewat Microsoft.Data.Sqlite (schedules.db di LocalAppData\
       Jembatan). Mesin SQLite (SQLitePCLRaw e_sqlite3) ikut
       ter-extract dari berkas tunggal lewat
       IncludeNativeLibrariesForSelfExtract di atas. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

</Project>
